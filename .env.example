# KarigarAI Application Supabase (Frontend & App Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-karigarai-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-karigarai-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-karigarai-publishable-key

# Server-Side Python AI Backend URL (Internal Next.js Bridge Proxy)
PYTHON_AI_API_URL=http://localhost:8000
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000

# Friend / Existing AI Supabase Credentials (Used by Python Backend)
FRIEND_SUPABASE_URL=https://your-friend-project.supabase.co
FRIEND_SUPABASE_KEY=your-friend-anon-or-service-key

# Gemini AI API Key (Used by Python Backend)
GEMINI_API_KEY=your-gemini-api-key
